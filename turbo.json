{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "db:codegen": {
      "cache": false
    },
    "seed-db": {
      "cache": false
    },
    "migrate:deploy": {
      "cache": false
    },
    "migrate:reset": {
      "cache": false
    },
    "migrate:generate": {
      "cache": false
    },
    "migrate:sync": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "//#lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
