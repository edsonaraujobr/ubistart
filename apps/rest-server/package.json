{
  "name": "@repo/rest-server",
  "version": "1.0.0",
  "description": "Taqtile's Template Server using Node and Typescript",
  "scripts": {
    "build": "tsc && node esbuild.mjs",
    "dev": "tsx --watch ./src/index.ts",
    "start": "node --import=./esm-module-alias-register.js dist/bundle.mjs",
    "test": "NODE_ENV=test mocha src/test/index.ts",
    "seed-db": "NODE_ENV=test tsx ./src/test/seeds/seed.ts",
    "email": "email dev --dir ./src/domain/email/templates"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@cucumber/cucumber": "12.2.0",
    "@fastify/compress": "8.0.0",
    "@fastify/cors": "10.0.0",
    "@fastify/helmet": "12.0.0",
    "@fastify/request-context": "6.0.1",
    "@fastify/swagger": "9.0.0",
    "@fastify/swagger-ui": "5.0.1",
    "@react-email/components": "0.0.36",
    "@react-email/render": "1.0.6",
    "@repo/core": "0.1.0",
    "@repo/db": "0.1.0",
    "@repo/env": "0.1.0",
    "axios": "1.7.9",
    "date-fns": "4.1.0",
    "dotenv": "16.4.5",
    "esm-module-alias": "2.2.1",
    "expo-server-sdk": "3.15.0",
    "fastify": "5.0.0",
    "fastify-type-provider-zod": "4.0.2",
    "nanoid": "5.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@faker-js/faker": "9.6.0",
    "@repo/tsconfig": "0.1.0",
    "@types/chai": "5.0.1",
    "@types/mocha": "10.0.9",
    "@types/node": "22.2.0",
    "@types/react": "19.1.0",
    "@types/sinon": "17.0.3",
    "chai": "5.1.2",
    "chai-exclude": "3.0.1",
    "copyfiles": "2.4.1",
    "esbuild-copy-static-files": "0.1.0",
    "glob": "11.0.0",
    "mocha": "10.7.3",
    "react-email": "4.0.5",
    "sinon": "17.0.2",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "aliases": {
    "@api": "dist/api",
    "@core": "dist/core",
    "@data": "dist/data",
    "@domain": "dist/domain",
    "@env": "dist/env",
    "@model": "dist/model",
    "@test": "dist/test"
  }
}
