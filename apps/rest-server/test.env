#
# Pre-defined variables (don't change names)
# ------------------------------------------
NODE_ENV=development
PORT=4001
NPM_CONFIG_PRODUCTION=false
# Possible values (in order): debug, info, warn, error, critical
LOGGER_LEVEL=critical

# 
# Crypto
# -------------

CRYPTO_SALT=salt

#
# Database
# --------

# DATABASE_URL="<dialect>://<username>:<password>@<host>:<port>/<db_name>"
DATABASE_URL="mysql://root:root@localhost:3307/testdb"

# 
# Core / JWT
# ----------

JWT_EXPIRATION=1d
JWT_SECRET=secret
SESSION_DURATION=7

ENABLE_SWAGGER=false
